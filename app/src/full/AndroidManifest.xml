<?xml version="1.0" encoding="utf-8"?>
<!-- "full" flavor only: the connections Play Protect blocks in sideloaded apps. Install with adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <application>
        <!-- App notifications connection: Android delivers notifications only after the user grants access. -->
        <service
            android:name=".StudioNotificationListener"
            android:exported="true"
            android:label="Tune2AI Studio"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
